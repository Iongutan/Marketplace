@model Marketplace.Domain.Entities.Product

@{
    ViewData["Title"] = "Admin - Editează Produs";
}

<div class="row justify-content-center">
    <div class="col-md-10">
        <div class="product-card-premium p-5 shadow-lg border-0">
            <div class="mb-5 d-flex justify-content-between align-items-start">
                <div>
                    <span class="badge bg-danger bg-opacity-10 text-danger mb-3 px-3 py-2 rounded-pill fw-bold">Mod
                        Admin</span>
                    <h1 class="display-6 fw-bold">Editează Produsul #@Model.Id</h1>
                    <p class="text-muted fs-5">Modificarea acestui produs va afecta listarea publică imediat.</p>
                </div>
                <a asp-action="Dashboard" class="btn btn-light rounded-pill px-4">Înapoi la Dashboard</a>
            </div>

            <form asp-action="EditProduct" method="post" enctype="multipart/form-data" class="row g-4">
                <input type="hidden" asp-for="Id" />
                <input type="hidden" asp-for="UserId" />
                <input type="hidden" asp-for="CreatedDate" />

                <div class="col-md-8">
                    <label asp-for="Name" class="form-label text-uppercase small letter-spacing-wide">Nume
                        Produs</label>
                    <input asp-for="Name" class="form-control form-control-lg border-light-subtle rounded-3"
                        placeholder="ex: iPhone 15 Pro" required />
                    <span asp-validation-for="Name" class="text-danger small"></span>
                </div>

                <div class="col-md-4">
                    <label asp-for="Category"
                        class="form-label text-uppercase small letter-spacing-wide">Categorie</label>
                    <select asp-for="Category" class="form-select form-select-lg border-light-subtle rounded-3">
                        <option value="Interior">Interior</option>
                        <option value="Produse Fizice">Produse Fizice</option>
                        <option value="Produse Digitale">Produse Digitale</option>
                        <option value="Servicii">Servicii</option>
                    </select>
                </div>

                <div class="col-md-6">
                    <label asp-for="Brand" class="form-label text-uppercase small letter-spacing-wide">Brand</label>
                    <input asp-for="Brand" class="form-control form-control-lg border-light-subtle rounded-3"
                        placeholder="ex: Apple, Samsung" />
                </div>

                <div class="col-md-3">
                    <label for="Price" class="form-label text-uppercase small letter-spacing-wide">Preț
                        (MDL)</label>
                    <input type="number" id="Price" name="Price" step="1" min="0"
                        value="@((int)(Model.Price ?? 0))"
                        class="form-control form-control-lg border-light-subtle rounded-3" required />
                    <span asp-validation-for="Price" class="text-danger small"></span>
                </div>

                <div class="col-md-4">
                    <label class="form-label text-uppercase small letter-spacing-wide">Strategie Preț
                        <span class="text-muted fw-normal">(Strategy Pattern)</span></label>
                    <select name="pricingStrategy" id="pricingStrategy" class="form-select form-select-lg border-light-subtle rounded-3" onchange="applyStrategy(this.value)">
                        <option value="regular" selected>Preț Regulat (fără reducere)</option>
                        <option value="holiday">Reducere Sărbători (−20%)</option>
                        <option value="clearance">Lichidare Stoc (−50%)</option>
                    </select>
                    <div id="strategyPreview" class="mt-2 small text-muted d-none">
                        <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1 rounded-pill">
                            💰 Preț calculat: <span id="strategyResult"></span> MDL
                        </span>
                    </div>
                </div>

                <div class="col-md-3">
                    <label asp-for="Stock" class="form-label text-uppercase small letter-spacing-wide">Stoc</label>
                    <input asp-for="Stock" type="number"
                        class="form-control form-control-lg border-light-subtle rounded-3" required />
                    <span asp-validation-for="Stock" class="text-danger small"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="ImageUrl" class="form-label text-uppercase small letter-spacing-wide">Sau URL
                        Imagine</label>
                    <input asp-for="ImageUrl" class="form-control form-control-lg border-light-subtle rounded-3"
                        placeholder="https://..." />
                </div>

                <div class="col-md-6">
                    <label class="form-label text-uppercase small letter-spacing-wide">Încarcă Imagine Nouă
                        (Opțional)</label>
                    <input type="file" name="ImageFile"
                        class="form-control form-control-lg border-light-subtle rounded-3" accept="image/*" />
                </div>

                <div class="col-md-12">
                    <label asp-for="Description" class="form-label text-uppercase small letter-spacing-wide">Descriere
                        Detaliată</label>
                    <textarea asp-for="Description" class="form-control border-light-subtle rounded-3" rows="6"
                        placeholder="Descrie produsul..."></textarea>
                </div>

                <div class="col-md-12">
                    <div class="form-check form-switch p-3 bg-light rounded-3 d-flex align-items-center gap-3">
                        <input type="checkbox" name="IsDigital" value="true" class="form-check-input ms-0"
                            id="flexSwitchCheckDefault" @(Model.IsDigital == true ? "checked" : "")
                            style="width: 3rem; height: 1.5rem;">
                        <input type="hidden" name="IsDigital" value="false">
                        <label class="form-check-label fw-bold mb-0" for="flexSwitchCheckDefault">Marchează ca produs
                            Produs Digital</label>
                    </div>
                </div>

                <div class="col-md-12 mt-5">
                    <div class="d-flex gap-3">
                        <button type="submit"
                            class="btn btn-primary btn-lg px-5 py-3 rounded-3 shadow-sm border-0">Salvează
                            Modificările</button>
                        <a asp-action="Dashboard"
                            class="btn btn-outline-secondary btn-lg px-5 py-3 rounded-3">Anulează</a>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
    function applyStrategy(strategy) {
        const priceInput = document.getElementById('Price');
        const basePrice = parseInt(priceInput.value) || 0;
        const preview = document.getElementById('strategyPreview');
        const resultSpan = document.getElementById('strategyResult');

        if (strategy === 'regular') {
            preview.classList.add('d-none');
            return;
        }

        let newPrice = basePrice;
        if (strategy === 'holiday') newPrice = Math.round(basePrice * 0.8);
        else if (strategy === 'clearance') newPrice = Math.round(basePrice * 0.5);

        resultSpan.textContent = newPrice.toLocaleString('ro-MD');
        preview.classList.remove('d-none');

        // Update the price field so the form submits the discounted price
        priceInput.value = newPrice;
    }
</script>

<style>
    .letter-spacing-wide {
        letter-spacing: 0.05em;
        color: #64748b;
    }

    .display-6 {
        letter-spacing: -0.025em;
    }
</style>
