@using Marketplace.BusinessLogic.State
@{
    ViewData["Title"] = "Status Comandă";
    var order = ViewBag.OrderContext as OrderContext;
    int productId = ViewBag.ProductId ?? 0;
    string currentState = order?.CurrentState.StateName ?? "Plasată";
}

<div class="row justify-content-center">
    <div class="col-lg-8">

        <!-- Header -->
        <div class="text-center mb-5 mt-4">
            <h1 class="fw-bold mb-2">Tracking Comandă</h1>
            <p class="text-muted">
                Urmăriți statusul comenzii în timp real.
            </p>
        </div>

        @if (order != null)
        {
            <!-- Order info -->
            <div class="card border-0 shadow-sm mb-4" style="background:linear-gradient(135deg,#1a1a2e,#16213e);color:#fff;">
                <div class="card-body p-4">
                    <div class="row align-items-center">
                        <div class="col-md-8">
                            <h5 class="mb-1">Comanda #@order.OrderId</h5>
                            <p class="mb-1 text-white-50">@order.ProductName</p>
                            <p class="mb-0 text-white-50">Client: @order.CustomerName &bull; Total: <strong class="text-success">@order.TotalPrice.ToString("N0") MDL</strong></p>
                        </div>
                        <div class="col-md-4 text-md-end mt-3 mt-md-0">
                            <span class="badge bg-@order.CurrentState.StateColor fs-6 px-3 py-2">
                                @order.CurrentState.StateName
                            </span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Progress Bar -->
            <div class="card shadow-sm border-0 mb-4">
                <div class="card-header bg-white border-bottom">Evoluție Comandă</div>
                <div class="card-body p-4">
                    @{
                        var states = new[] { "Plasată", "În Procesare", "Expediată", "Livrată" };
                        var currentIdx = order.CurrentState switch {
                            PlacedState     => 0,
                            ProcessingState => 1,
                            ShippedState    => 2,
                            DeliveredState  => 3,
                            CancelledState  => -1,
                            _               => 0
                        };
                        
                        double progressPercentage = currentIdx switch {
                            0 => 25,
                            1 => 50,
                            2 => 75,
                            3 => 100,
                            -1 => 100,
                            _ => 0
                        };
                    }

                    @if (order.CurrentState is CancelledState)
                    {
                        <div class="alert alert-danger text-center">
                            <strong>Comanda a fost anulată.</strong> Nu va fi livrată.
                        </div>
                        <div class="progress" style="height: 10px;">
                            <div class="progress-bar bg-danger" role="progressbar" style="width: 100%;"></div>
                        </div>
                    }
                    else
                    {
                        <div class="position-relative m-4">
                            <div class="progress" style="height: 6px;">
                                <div class="progress-bar bg-success" role="progressbar" style="width: @progressPercentage%;"></div>
                            </div>
                            
                            <div class="d-flex justify-content-between position-absolute top-0 w-100" style="margin-top: -12px;">
                                @for (int i = 0; i < states.Length; i++)
                                {
                                    bool isActive = i <= currentIdx;
                                    <div class="text-center" style="width: 20px;">
                                        <div class="rounded-circle @(isActive ? "bg-success" : "bg-light border")" style="width: 30px; height: 30px; margin-left: -5px;"></div>
                                        <div class="mt-2 text-muted" style="font-size: 0.75rem; margin-left: -20px; width: 60px;">@states[i]</div>
                                    </div>
                                }
                            </div>
                        </div>
                    }
                </div>
            </div>

            <!-- Action buttons to simulate transitions -->
            @if (!(order.CurrentState is CancelledState) && !(order.CurrentState is DeliveredState))
            {
                <div class="card shadow-sm border-0 mb-4">
                    <div class="card-body p-3 d-flex justify-content-between align-items-center flex-wrap">
                        <div class="text-muted small">Acțiuni disponibile pentru comandă:</div>
                        <div class="d-flex gap-2 mt-2 mt-md-0">
                            @if (order.CurrentState is PlacedState)
                            {
                                <a asp-controller="Order" asp-action="OrderStatus" asp-route-productId="@productId" asp-route-currentState="Processing" class="btn btn-sm btn-info">Procesează</a>
                            }
                            @if (order.CurrentState is ProcessingState)
                            {
                                <a asp-controller="Order" asp-action="OrderStatus" asp-route-productId="@productId" asp-route-currentState="Shipped" class="btn btn-sm btn-primary">Expediază</a>
                            }
                            @if (order.CurrentState is ShippedState)
                            {
                                <a asp-controller="Order" asp-action="OrderStatus" asp-route-productId="@productId" asp-route-currentState="Delivered" class="btn btn-sm btn-success">Livrează</a>
                            }
                            
                            <a asp-controller="Order" asp-action="OrderStatus" asp-route-productId="@productId" asp-route-currentState="Cancelled" class="btn btn-sm btn-outline-danger" onclick="return confirm('Sigur doriți să anulați comanda?')">Anulează Comanda</a>
                        </div>
                    </div>
                </div>
            }

            <!-- History log -->
            <div class="card shadow-sm border-0">
                <div class="card-header bg-light border-bottom">Istoric Jurnal</div>
                <div class="card-body p-3">
                    <ul class="list-unstyled mb-0">
                        @foreach (var entry in order.History)
                        {
                            <li class="py-1 border-bottom text-muted" style="font-size:0.87rem;">
                                @entry
                            </li>
                        }
                    </ul>
                </div>
            </div>
        }

        <div class="text-center mt-4">
            <a asp-controller="Order" asp-action="Checkout" asp-route-productId="@productId" class="btn btn-outline-dark me-2">← Checkout</a>
            <a asp-controller="Home" asp-action="Index" class="btn btn-dark">Acasă</a>
        </div>

    </div>
</div>
